         "default": "./src/server/index.ts",
         "types": "./dist/src/server/index.d.ts"
      }
   },
   "files": [
      "dist"
   ],
   "license": "Apache-2.0",
   "name": "@packages/api",
   "private": true,
   "scripts": {
      "build": "tsc --build",
      "check": "biome check --write ./src",
      "typecheck": "tsc "
   },
   "type": "module",
   "version": "0.9.1"
}
