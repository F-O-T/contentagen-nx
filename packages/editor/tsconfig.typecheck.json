{
   "$schema": "https://json.schemastore.org/tsconfig",
   "extends": "@tooling/typescript/typecheck.json",
   "compilerOptions": {
      "jsx": "react-jsx",
      "lib": ["dom", "dom.iterable", "ES2023"],
      "baseUrl": ".",
      "paths": {
         "@packages/ui/*": ["../ui/src/*"],
         "@packages/utils/*": ["../utils/src/*"]
      }
   },
   "include": ["src/**/*.ts", "src/**/*.tsx"],
   "exclude": ["node_modules", "dist"]
}
