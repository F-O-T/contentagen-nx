FROM oven/bun:latest AS base

# ---- Dependencies ----
FROM base AS deps
WORKDIR /app

# Copy workspace-level manifests first for layer caching
COPY bun.lock package.json ./

# tooling
COPY tooling/typescript/package.json ./tooling/typescript/

# packages
COPY packages/agents/package.json ./packages/agents/
COPY packages/analytics/package.json ./packages/analytics/
COPY packages/arcjet/package.json ./packages/arcjet/
COPY packages/authentication/package.json ./packages/authentication/
COPY packages/database/package.json ./packages/database/
COPY packages/environment/package.json ./packages/environment/
COPY packages/events/package.json ./packages/events/
COPY packages/feedback/package.json ./packages/feedback/
COPY packages/files/package.json ./packages/files/
COPY packages/logging/package.json ./packages/logging/
COPY packages/posthog/package.json ./packages/posthog/
COPY packages/queue/package.json ./packages/queue/
COPY packages/redis/package.json ./packages/redis/
COPY packages/search/package.json ./packages/search/
COPY packages/stripe/package.json ./packages/stripe/
COPY packages/transactional/package.json ./packages/transactional/
COPY packages/ui/package.json ./packages/ui/
COPY packages/utils/package.json ./packages/utils/

# apps
COPY apps/web/package.json ./apps/web/
COPY apps/sdk-server/package.json ./apps/sdk-server/
COPY apps/worker/package.json ./apps/worker/

# libraries
COPY libraries/sdk/package.json ./libraries/sdk/

RUN bun install --frozen-lockfile

# ---- Builder ----
FROM base AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NODE_ENV=production
ENV PATH="/app/node_modules/.bin:${PATH}"

# VITE_ vars are baked in at build time
ARG VITE_POSTHOG_HOST
ARG VITE_POSTHOG_KEY
ENV VITE_POSTHOG_HOST=$VITE_POSTHOG_HOST
ENV VITE_POSTHOG_KEY=$VITE_POSTHOG_KEY

RUN bun run --filter=web build

# ---- Runner ----
FROM oven/bun:latest AS runner
WORKDIR /app

ENV NODE_ENV=production

# Copy the Nitro output — server + public assets
COPY --from=builder /app/apps/web/.output ./

EXPOSE 3000

CMD ["bun", "run", "server/index.mjs"]
